# General
PORT=4242
NODE_ENV=development

# Database (Neon Postgres)
DATABASE_URL=your_neon_database_url

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Session Management
SESSION_COOKIE_NAME=sid
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=7

# Auth0 / OIDC
OIDC_ISSUER=your_auth0_issuer
OIDC_AUDIENCE=your_auth0_audience
OIDC_ISSUER_URL=your_auth0_issuer_url/
OIDC_CLIENT_ID=your_auth0_client_id
OIDC_CLIENT_SECRET=your_auth0_client_secret
OIDC_REDIRECT_URI=http://localhost:4242/auth/callback
OIDC_SCOPE="openid profile email"
OIDC_PROVIDER_NAME=auth0
OIDC_END_SESSION_URL=your_idp_end_session_url
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# Auth Redirects
AUTH_REDIRECT_AFTER_LOGIN=http://localhost:5173/dashboard
AUTH_REDIRECT_AFTER_LOGOUT=http://localhost:5173

# Vercel Blob (for image uploads)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
